{
  "$schema": "./agentz.schema.json",
  "primary": {
    "model": "minimax/m2.7",
    "role": "controller"
  },
  "agents": {
    "planner": {
      "modelChain": [
        {
          "provider": "groq",
          "model": "meta-llama/llama-4-scout-17b-16e-instruct",
          "reason": "Fast planning"
        },
        {
          "provider": "cerebras",
          "model": "qwen-3-235b-a22b-instruct-2507",
          "reason": "Good reasoning"
        },
        {
          "provider": "ollama-cloud",
          "model": "minimax-m2.7",
          "reason": "Fallback"
        },
        {
          "provider": "opencode",
          "model": "qwen3.6-plus-free",
          "reason": "Secondary fallback"
        }
      ],
      "timeoutSeconds": 300,
      "fallbackTrigger": "no_output"
    },
    "coder": {
      "modelChain": [
        {
          "provider": "mistral",
          "model": "devstral-small-2507",
